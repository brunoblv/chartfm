# Spotify Web API (fluxo client credentials — busca e capas)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Redirect OAuth admin — cadastre EXATAMENTE no Spotify Developer Dashboard.
# Regras Spotify (2025+): HTTPS em prod; localhost NÃO é aceito — use 127.0.0.1:
#   http://127.0.0.1:3000/api/spotify/callback   (dev)
#   https://chartfm.com.br/api/spotify/callback  (prod)
# SPOTIFY_REDIRECT_URI=https://chartfm.com.br/api/spotify/callback

# Redirect OAuth usuários comuns — cadastre TAMBÉM no Spotify Developer Dashboard:
#   http://127.0.0.1:3000/api/spotify/connect/callback   (dev)
#   https://chartfm.com.br/api/spotify/connect/callback  (prod)
# SPOTIFY_USER_REDIRECT_URI=https://chartfm.com.br/api/spotify/connect/callback
#
# Modo Development da Spotify: só até 5 usuários na allowlist (Users Management).
# Para liberar qualquer usuário, solicite Extended Quota Mode no Developer Dashboard.

# Last.fm (MyTRL + import + tags de faixa)
LASTFM_USERNAME=
API_KEY=

# MusicBrainz (tags de gênero por faixa — User-Agent obrigatório)
# MUSICBRAINZ_USER_AGENT=ChartFM/1.0 (https://chartfm.com.br; contact@chartfm.com.br)

# Cron na VPS (scripts/cron-hit.sh) — opcional em dev
CRON_SECRET=

# Telegram — notifica o grupo a cada evento "da casa" (paradas, Copa, Push, Clube,
# avisos, votação da semana). Sem TELEGRAM_BOT_TOKEN + TELEGRAM_CHAT_ID, nada é enviado.
# 1) Crie um bot no @BotFather e copie o token abaixo.
# 2) Adicione o bot ao grupo do ChartFM (dando permissão de postar).
# 3) Envie uma mensagem qualquer no grupo e rode: npm run telegram:chat-id
#    (ele lê getUpdates e imprime o chat_id do grupo, ex.: -1001234567890)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Liga/desliga o envio (padrão: ligado quando token e chat_id existem). Use 0 para pausar.
# TELEGRAM_ENABLED=1
# Base pública usada nos links das mensagens (padrão https://chartfm.com.br).
# TELEGRAM_PUBLIC_BASE_URL=https://chartfm.com.br
#
# A imagem do card é gerada no servidor via Playwright/Chromium. Na VPS, instale o
# navegador uma vez: npx playwright install --with-deps chromium
# Se o Chromium não estiver disponível, o envio cai automaticamente para texto.

# Google AdSense — crie cada slot no painel e cole o data-ad-slot (só números)
# NEXT_PUBLIC_ADSENSE_SLOT_SONG=
# NEXT_PUBLIC_ADSENSE_SLOT_CHART=
# NEXT_PUBLIC_ADSENSE_SLOT_GLOBAL_HUB=
# NEXT_PUBLIC_ADSENSE_SLOT_GLOBAL_100=
# NEXT_PUBLIC_ADSENSE_SLOT_PROFILE=
# NEXT_PUBLIC_ADSENSE_SLOT_HOME_FEED=
# NEXT_PUBLIC_ADSENSE_SLOT_CRITICS_FM=

# Base URL para scripts/cron-hit.sh na VPS (padrão http://127.0.0.1:3000)
# APP_BASE_URL=https://chartfm.com.br

# Modo manutenção (deploy) — redireciona todo o site para /manutencao
# MAINTENANCE_MODE=1
# Segredo para você testar o site durante o deploy: acesse /?bypass=SEU_SEGREDO
# MAINTENANCE_BYPASS_SECRET=

# Envio de email (Resend) — confirmação de cadastro e reset de senha
# Sem RESEND_API_KEY, em produção NENHUM email é enviado (usuários não conseguem
# confirmar o cadastro e ficam travados no login). Em dev, o email é só logado no console.
# 1) Crie conta em https://resend.com e gere uma API key (começa com "re_").
# 2) Verifique seu domínio em Resend → Domains (SPF/DKIM no DNS) para poder enviar
#    de noreply@chartfm.com.br. O domínio de EMAIL_FROM PRECISA ser um domínio verificado.
RESEND_API_KEY=
# Remetente. O domínio aqui tem que estar verificado no Resend (default do código:
# "ChartFM <noreply@chartfm.com>", que provavelmente NÃO é o seu domínio real).
EMAIL_FROM=ChartFM <noreply@chartfm.com.br>

# NextAuth — login com Google
# Dev: use 127.0.0.1 (cookies OAuth não cruzam com localhost)
NEXTAUTH_URL=http://127.0.0.1:3000
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirect NextAuth (login Google) — cliente GOOGLE_CLIENT_ID:
#   http://127.0.0.1:3000/api/auth/callback/google

# YouTube OAuth (canal @chartFM) — cliente SEPARADO (YOUTUBE_CLIENT_ID):
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REDIRECT_URI=http://127.0.0.1:3000/api/youtube/connect/callback
# Cadastre EXATAMENTE no Google Cloud → Credenciais → cliente YOUTUBE:
#   Origem JS: http://127.0.0.1:3000
#   Redirect:  http://127.0.0.1:3000/api/youtube/connect/callback
# Ative também: YouTube Data API v3
# CHARTFM_YOUTUBE_HANDLE=chartFM
# DATABASE_URL="file:./dev.db"
