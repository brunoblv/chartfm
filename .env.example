# Spotify Web API (fluxo client credentials — busca e capas)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Redirect OAuth usuário (cadastre em Spotify Developer Dashboard):
# http://localhost:3000/api/spotify/callback  (dev)
# https://seu-dominio/api/spotify/callback    (prod)

# Last.fm (MyTRL + import)
LASTFM_USERNAME=
API_KEY=

# Cron Vercel (opcional em dev)
CRON_SECRET=

# NextAuth — login com Google
# URL pública da app (dev: http://localhost:3000)
NEXTAUTH_URL=http://localhost:3000
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Banco (Prisma) — SQLite por padrão
# DATABASE_URL="file:./dev.db"
