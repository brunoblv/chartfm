# Spotify Web API (fluxo client credentials — busca e capas)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Redirect OAuth admin — cadastre EXATAMENTE no Spotify Developer Dashboard.
# Regras Spotify (2025+): HTTPS em prod; localhost NÃO é aceito — use 127.0.0.1:
#   http://127.0.0.1:3000/api/spotify/callback   (dev)
#   https://chartfm.com.br/api/spotify/callback  (prod)
# SPOTIFY_REDIRECT_URI=https://chartfm.com.br/api/spotify/callback

# Redirect OAuth usuários comuns — cadastre TAMBÉM no Spotify Developer Dashboard:
#   http://127.0.0.1:3000/api/spotify/connect/callback   (dev)
#   https://chartfm.com.br/api/spotify/connect/callback  (prod)
# SPOTIFY_USER_REDIRECT_URI=https://chartfm.com.br/api/spotify/connect/callback
#
# Modo Development da Spotify: só até 5 usuários na allowlist (Users Management).
# Para liberar qualquer usuário, solicite Extended Quota Mode no Developer Dashboard.

# Last.fm (MyTRL + import + tags de faixa)
LASTFM_USERNAME=
API_KEY=

# MusicBrainz (tags de gênero por faixa — User-Agent obrigatório)
# MUSICBRAINZ_USER_AGENT=ChartFM/1.0 (https://chartfm.com.br; contact@chartfm.com.br)

# Cron na VPS (scripts/cron-hit.sh) — opcional em dev
CRON_SECRET=

# Base URL para scripts/cron-hit.sh na VPS (padrão http://127.0.0.1:3000)
# APP_BASE_URL=https://chartfm.com.br

# NextAuth — login com Google
# Dev: use 127.0.0.1 (cookies OAuth não cruzam com localhost)
NEXTAUTH_URL=http://127.0.0.1:3000
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirect NextAuth (login Google) — cliente GOOGLE_CLIENT_ID:
#   http://127.0.0.1:3000/api/auth/callback/google

# YouTube OAuth (canal @chartFM) — cliente SEPARADO (YOUTUBE_CLIENT_ID):
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REDIRECT_URI=http://127.0.0.1:3000/api/youtube/connect/callback
# Cadastre EXATAMENTE no Google Cloud → Credenciais → cliente YOUTUBE:
#   Origem JS: http://127.0.0.1:3000
#   Redirect:  http://127.0.0.1:3000/api/youtube/connect/callback
# Ative também: YouTube Data API v3
# CHARTFM_YOUTUBE_HANDLE=chartFM
# DATABASE_URL="file:./dev.db"
