# ChartFM — crons da VPS (/root/chartfm)
#
# Instalar:
#   chmod +x /root/chartfm/scripts/cron-hit.sh
#   mkdir -p /root/chartfm/logs
#   crontab /root/chartfm/deploy/crontab
#
# .env: CRON_SECRET, APP_BASE_URL (ex. http://127.0.0.1:3000)
# Horários: America/Sao_Paulo

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
TZ=America/Sao_Paulo

# 0h — pontos das paradas + stats globais do app (artista/música/álbum nas páginas)
0 0 * * * /root/chartfm/scripts/cron-hit.sh /api/cron/daily-app-stats >> /root/chartfm/logs/cron.log 2>&1

# Terça 5h — Global 100 + Airplay + Álbuns (congelado até próxima terça) + playlists YouTube
0 5 * * 2 /root/chartfm/scripts/cron-hit.sh /api/cron/publish-weekly-globals >> /root/chartfm/logs/cron.log 2>&1

# 8h — stats por usuário/parada nas páginas de artista/música/álbum
0 8 * * * /root/chartfm/scripts/cron-hit.sh /api/cron/daily-user-stats >> /root/chartfm/logs/cron.log 2>&1

# MyTRL → UMS Request Live (@bruno) — seg–sex 8h (após daily-user-stats)
2 8 * * 1-5 /root/chartfm/scripts/cron-hit.sh /api/cron/mytrl >> /root/chartfm/logs/cron.log 2>&1

# MyTRL semanal — sexta 8:05
5 8 * * 5 /root/chartfm/scripts/cron-hit.sh /api/cron/mytrl-weekly >> /root/chartfm/logs/cron.log 2>&1

# Copa — reconcilia fases agendadas (de hora em hora)
0 * * * * /root/chartfm/scripts/cron-hit.sh /api/cron/copa-advance >> /root/chartfm/logs/cron.log 2>&1

# Clube do Álbum — reconcilia fases agendadas (de hora em hora)
5 * * * * /root/chartfm/scripts/cron-hit.sh /api/cron/clube-advance >> /root/chartfm/logs/cron.log 2>&1

# Push — reconcilia a rodada com os prazos (de hora em hora)
10 * * * * /root/chartfm/scripts/cron-hit.sh /api/cron/push-advance >> /root/chartfm/logs/cron.log 2>&1

# 3h — purga definitivamente paradas na lixeira há mais de 7 dias
0 3 * * * /root/chartfm/scripts/cron-hit.sh /api/cron/purge-deleted-paradas >> /root/chartfm/logs/cron.log 2>&1

# 0h20 — consolida analytics do dia anterior (visitas, sessões, tempo no site) e purga eventos >90d
20 0 * * * /root/chartfm/scripts/cron-hit.sh /api/cron/analytics-rollup >> /root/chartfm/logs/cron.log 2>&1

# Domingo 23:59 — abre a Votação da Semana (Melhor da Semana + Flashback) e notifica todos
59 23 * * 0 /root/chartfm/scripts/cron-hit.sh /api/cron/weekly-poll-open >> /root/chartfm/logs/cron.log 2>&1

# Radar de Lançamentos — checa artistas monitorados no Spotify e avisa no Telegram
# 4x/dia (não de hora em hora): ~200 artistas x 24h estourava a cota do app no Spotify
# e derrubava busca/capas com 429 prolongado (retry-after de horas). Incidente 2026-07-08.
15 0,6,12,18 * * * /root/chartfm/scripts/cron-hit.sh /api/cron/release-radar >> /root/chartfm/logs/cron.log 2>&1

# Radar de Lançamentos — terça 12h: sincroniza a lista com o top 200 do Global da semana
0 12 * * 2 /root/chartfm/scripts/cron-hit.sh /api/cron/release-radar-import >> /root/chartfm/logs/cron.log 2>&1

# Backfill de capas — 4h: completa metadados/capas de músicas salvas em modo degradado (Spotify em 429)
0 4 * * * /root/chartfm/scripts/cron-hit.sh /api/cron/backfill-covers >> /root/chartfm/logs/cron.log 2>&1

# Paradas "de estilo" (Parada.autoDecay) — reconcilia movimento semanal de posição, metade sobe/metade desce (de hora em hora)
20 * * * * /root/chartfm/scripts/cron-hit.sh /api/cron/genre-parada-decay >> /root/chartfm/logs/cron.log 2>&1
