generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  ADMIN
  DEV
}

model User {
  id                   String            @id @default(cuid())
  handle               String            @unique
  name                 String
  email                String?           @unique
  image                String?
  googleId             String?           @unique
  avatarColor          String            @default("#FA243C")
  bio                  String?
  followers            Int               @default(0)
  following            Int               @default(0)
  streak               Int               @default(0)
  verified             Boolean           @default(false)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  paradaNome           String?
  genres               String[]          @default([])
  role                 UserRole          @default(USER)
  needsHandle          Boolean           @default(false) @map("needs_handle")
  lastfmUser           String?
  spotifyAccessToken   String?           @map("spotify_access_token")
  spotifyRefreshToken  String?           @map("spotify_refresh_token")
  spotifyTokenExpiresAt DateTime?        @map("spotify_token_expires_at")
  spotifyUserId        String?           @map("spotify_user_id")
  spotifyNewHitsPlaylistId String?       @map("spotify_new_hits_playlist_id")
  youtubeAccessToken   String?           @map("youtube_access_token")
  youtubeRefreshToken  String?           @map("youtube_refresh_token")
  youtubeTokenExpiresAt DateTime?        @map("youtube_token_expires_at")
  youtubeChannelId     String?           @map("youtube_channel_id")
  youtubeChannelHandle String?           @map("youtube_channel_handle")
  twitterUser          String?
  instagramUser        String?
  chartSize            Int?              @map("chart_size")
  paradaLogo           String?           @map("parada_logo")
  paradas              Parada[]
  charts               Chart[]
  likes                ChartLike[]
  reposts              ChartRepost[]
  comments             Comment[]
  commentLikes         CommentLike[]
  commentReplies       CommentReply[]
  communityMemberships CommunityMember[]
  actorNotifs          Notification[]    @relation("NotificationActor")
  notifications        Notification[]    @relation("NotificationRecipient")
  posts                Post[]
  postLikes            PostLike[]
  postReplies          PostReply[]
  albumReviews         AlbumReview[]
  albumReviewHelpful   AlbumReviewHelpful[]
  ownedCommunities     Community[]        @relation("CommunityOwner")
  followerLinks        UserFollow[]       @relation("UserFollows")
  followingLinks       UserFollow[]       @relation("UserFollowing")
  uploadedVideoClips   SongVideoClip[]
  videoClipVotes       SongVideoClipVote[]
  videoClipChoices     UserSongVideoClipChoice[]
  albumClubNominations AlbumClubNomination[]
  albumClubPollVotes   AlbumClubPollVote[]
  pushSubmissions      PushSubmission[]
  pushVotes            PushVote[]
  songRecommendations  SongRecommendation[]
  songRecommendationLikes SongRecommendationLike[]
  songRecommendationComments SongRecommendationComment[]
  songRecommendationCommentLikes SongRecommendationCommentLike[]
  songRecommendationCommentReplies SongRecommendationCommentReply[]
  copaParticipations   CopaParticipant[]
  copaArtists          CopaArtist[]
  copaVotes            CopaVote[]
}

model Artist {
  id         Int        @id @default(autoincrement())
  spotifyId  String     @unique @map("spotify_id")
  name       String
  exhibitionName String? @map("exhibition_name")
  genres     String[]   @default([])
  imageUrl   String?    @map("image_url")
  spotifyUrl String?    @map("spotify_url")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  albums     Album[]
  songs      Song[]     @relation("PrimarySongArtist")
  feats      SongFeat[]

  @@index([spotifyId], map: "idx_artists_spotify_id")
  @@map("artists")
}

enum AlbumType {
  SINGLE
  EP
  ALBUM
  COMPILATION

  @@map("album_type")
}

model Album {
  id              Int         @id @default(autoincrement())
  spotifyId       String      @unique @map("spotify_id")
  title           String
  exhibitionName  String?     @map("exhibition_name")
  artistSpotifyId String      @map("artist_spotify_id")
  albumType       AlbumType?  @map("album_type")
  releaseDate     DateTime?   @map("release_date") @db.Date
  coverUrl        String?     @map("cover_url")
  spotifyUrl      String?     @map("spotify_url")
  totalTracks     Int?        @map("total_tracks")
  label           String?     @map("label")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  artist          Artist      @relation(fields: [artistSpotifyId], references: [spotifyId])
  songs           Song[]      @relation("AlbumSongs")
  chartEntries    ChartEntry[] @relation("ChartEntryAlbumSpotify")
  reviews              AlbumReview[]
  clubNominations      AlbumClubNomination[]
  weeklyReleaseAlbums  WeeklyReleaseAlbum[]

  @@index([spotifyId], map: "idx_albums_spotify_id")
  @@index([artistSpotifyId], map: "idx_albums_artist_spotify_id")
  @@map("albums")
}

model Song {
  id      String       @id @default(cuid())
  title   String
  exhibitionName String? @map("exhibition_name")
  artist  String
  album   String?
  entries ChartEntry[]
  spotifyId       String?      @unique @map("spotify_id")
  artistSpotifyId String?      @map("artist_spotify_id")
  albumSpotifyId  String?      @map("album_spotify_id")
  durationMs      Int?         @map("duration_ms")
  previewUrl      String?      @map("preview_url")
  spotifyUrl      String?      @map("spotify_url")
  trackNumber     Int?         @map("track_number")
  artistRef       Artist?      @relation("PrimarySongArtist", fields: [artistSpotifyId], references: [spotifyId])
  albumRef        Album?       @relation("AlbumSongs", fields: [albumSpotifyId], references: [spotifyId])
  feats           SongFeat[]
  chartEntriesBySpotify ChartEntry[] @relation("ChartEntrySongSpotify")
  videoClips            SongVideoClip[]
  videoClipChoices      UserSongVideoClipChoice[]
  pushSubmissions       PushSubmission[]
  recommendations       SongRecommendation[]

  @@unique([title, artist])
  @@index([spotifyId], map: "idx_songs_spotify_id")
  @@index([artistSpotifyId], map: "idx_songs_artist_spotify_id")
  @@index([albumSpotifyId], map: "idx_songs_album_spotify_id")
}

model SongFeat {
  id              Int      @id @default(autoincrement())
  songSpotifyId   String   @map("song_spotify_id")
  artistSpotifyId String   @map("artist_spotify_id")
  createdAt       DateTime @default(now()) @map("created_at")
  song            Song     @relation(fields: [songSpotifyId], references: [spotifyId], onDelete: Cascade)
  artist          Artist   @relation(fields: [artistSpotifyId], references: [spotifyId])

  @@unique([songSpotifyId, artistSpotifyId])
  @@index([songSpotifyId], map: "idx_song_feats_song_spotify_id")
  @@index([artistSpotifyId], map: "idx_song_feats_artist_spotify_id")
  @@map("song_feats")
}

enum ChartType {
  SONGS
  ALBUMS
  MIXED
  VIDEO_CLIP
}

enum ParadaCadence {
  WEEKLY
  DAILY
}

model Parada {
  id        String        @id @default(cuid())
  userId    String        @map("user_id")
  name      String
  logo      String?       @map("logo")
  genres    String[]      @default([])
  isPrimary Boolean       @default(true) @map("is_primary")
  sortOrder Int           @default(0) @map("sort_order")
  chartSize Int?          @map("chart_size")
  cadence   ParadaCadence @default(WEEKLY)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  charts    Chart[]

  @@unique([userId, sortOrder])
  @@index([userId], map: "idx_paradas_user_id")
  @@map("paradas")
}

model Chart {
  id            String        @id @default(cuid())
  userId        String
  paradaId      String        @map("parada_id")
  weekIndex     Int
  weekLabel     String
  dateRange     String
  publishedAt   DateTime      @default(now())
  likes         Int           @default(0)
  comments      Int           @default(0)
  reposts       Int           @default(0)
  user          User          @relation(fields: [userId], references: [id])
  parada        Parada        @relation(fields: [paradaId], references: [id], onDelete: Cascade)
  entries       ChartEntry[]
  chartLikes    ChartLike[]
  chartReposts  ChartRepost[]
  chartComments Comment[]
  slug          String?       @unique
  title         String?
  description   String?
  chartType     ChartType     @default(SONGS) @map("chart_type")
  weekStartDate DateTime?     @map("week_start_date") @db.Date
  isPublished   Boolean       @default(true) @map("is_published")
  maxItems      Int           @default(100) @map("max_items")
  communityId   String?       @map("community_id")
  community     Community?    @relation(fields: [communityId], references: [id])

  @@unique([paradaId, weekIndex])
  @@index([userId, weekStartDate], map: "idx_charts_user_week")
  @@index([paradaId], map: "idx_charts_parada_id")
  @@index([communityId], map: "charts_communityId_fkey")
  @@index([slug], map: "idx_charts_slug")
}

model ChartEntry {
  id            String @id @default(cuid())
  chartId       String
  songId        String
  position      Int
  points        Int    @default(0)
  createdAt     DateTime @default(now()) @map("created_at")
  songSpotifyId String?  @map("song_spotify_id")
  albumSpotifyId String? @map("album_spotify_id")
  status        String @default("new")
  delta         Int?
  prevPos       Int?
  peak          Int
  weeks         Int    @default(1)
  coverPaletteA String @default("#FF6B6B")
  coverPaletteB String @default("#FFE66D")
  coverSeed     Int    @default(0)
  chart         Chart  @relation(fields: [chartId], references: [id], onDelete: Cascade)
  song          Song   @relation(fields: [songId], references: [id])
  songBySpotify Song?  @relation("ChartEntrySongSpotify", fields: [songSpotifyId], references: [spotifyId])
  albumBySpotify Album? @relation("ChartEntryAlbumSpotify", fields: [albumSpotifyId], references: [spotifyId])

  @@unique([chartId, position])
  @@index([chartId, position], map: "idx_chart_entries_chart_position")
  @@index([songId], map: "idx_chart_entries_song_id")
  @@index([songId, position], map: "idx_chart_entries_song_position")
  @@index([songSpotifyId], map: "idx_chart_entries_song_spotify_id")
  @@index([albumSpotifyId], map: "idx_chart_entries_album_spotify_id")
}

model ChartLike {
  id        String   @id @default(cuid())
  userId    String
  chartId   String
  createdAt DateTime @default(now())
  chart     Chart    @relation(fields: [chartId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, chartId])
}

model ChartRepost {
  id        String   @id @default(cuid())
  userId    String
  chartId   String
  createdAt DateTime @default(now())
  chart     Chart    @relation(fields: [chartId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, chartId])
}

model Comment {
  id         String         @id @default(cuid())
  chartId    String
  userId     String
  text       String
  likes      Int            @default(0)
  reactions  String         @default("[]")
  replyCount Int            @default(0)
  createdAt  DateTime       @default(now())
  chart      Chart          @relation(fields: [chartId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id])
  commentLikes CommentLike[]
  replies    CommentReply[]
}

model CommentLike {
  id        String   @id @default(cuid())
  userId    String
  commentId String   @map("comment_id")
  createdAt DateTime @default(now())
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, commentId])
  @@map("comment_likes")
}

model CommentReply {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  text      String
  likes     Int      @default(0)
  createdAt DateTime @default(now())
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@index([commentId])
}

model Community {
  id               String            @id @default(cuid())
  slug             String            @unique
  name             String
  tagline          String
  icon             String            @default("🎵")
  logoUrl          String?
  coverA           String            @default("#FA243C")
  coverB           String            @default("#FF5858")
  members          Int               @default(0)
  posts            Int               @default(0)
  founded          String
  privacy          String            @default("public")
  rules            String?
  createdAt        DateTime          @default(now())
  communityMembers CommunityMember[]
  communityPosts   Post[]
  maxSongs         Int               @default(50)
  isPublic         Boolean           @default(true)
  ownerId          String?
  owner            User?             @relation("CommunityOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  charts           Chart[]

  @@index([ownerId], map: "communities_ownerId_fkey")
}

model CommunityMember {
  id          String    @id @default(cuid())
  userId      String
  communityId String
  role        String    @default("member")
  joinedAt    DateTime  @default(now())
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id])

  @@unique([userId, communityId])
}

model Post {
  id            String      @id @default(cuid())
  communityId   String
  userId        String
  kind          String      @default("text")
  text          String
  imageUrl      String?
  imagePaletteA String?
  imagePaletteB String?
  imageText     String?
  imageCaption  String?
  youtubeId     String?
  ytTitle       String?
  ytChannel     String?
  ytThumbA      String?
  ytThumbB      String?
  likes         Int         @default(0)
  replies       Int         @default(0)
  shares        Int         @default(0)
  createdAt     DateTime    @default(now())
  community     Community   @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id])
  postLikes     PostLike[]
  postReplies   PostReply[]
}

model PostLike {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, postId])
}

model PostReply {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  text      String
  likes     Int      @default(0)
  replyToId String?
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
}

model Notification {
  id          String   @id @default(cuid())
  recipientId String
  actorId     String?
  type        String
  text        String
  targetUrl   String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  actor       User?    @relation("NotificationActor", fields: [actorId], references: [id])
  recipient   User     @relation("NotificationRecipient", fields: [recipientId], references: [id])
}

model UserFollow {
  id          String   @id @default(cuid())
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")
  follower    User     @relation("UserFollows", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId], map: "idx_user_follows_follower_id")
  @@index([followingId], map: "idx_user_follows_following_id")
  @@map("user_follows")
}

model GlobalSnapshot {
  id                String   @id @default(cuid())
  weekIndex         Int      @unique @map("week_index")
  weekLabel         String   @map("week_label")
  dateRange         String   @map("date_range")
  weeklySongs       Json     @map("weekly_songs")
  weeklyArtists     Json     @map("weekly_artists")
  overallSongs      Json     @map("overall_songs")
  overallArtists    Json     @map("overall_artists")
  youtubePlaylistId String?  @map("youtube_playlist_id")
  frozenAt          DateTime @default(now()) @map("frozen_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([weekIndex], map: "idx_global_snapshots_week_index")
  @@map("global_snapshots")
}

model GlobalAirplaySnapshot {
  id                String   @id @default(cuid())
  weekIndex         Int      @unique @map("week_index")
  weekLabel         String   @map("week_label")
  dateRange         String   @map("date_range")
  scoringWindow     String   @map("scoring_window")
  entries           Json
  contributorCount  Int      @map("contributor_count")
  youtubePlaylistId String?  @map("youtube_playlist_id")
  frozenAt          DateTime @default(now()) @map("frozen_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([weekIndex], map: "idx_global_airplay_snapshots_week_index")
  @@map("global_airplay_snapshots")
}

model GlobalAlbumsSnapshot {
  id               String   @id @default(cuid())
  weekIndex        Int      @unique @map("week_index")
  weekLabel        String   @map("week_label")
  dateRange        String   @map("date_range")
  scoringWindow    String   @map("scoring_window")
  entries          Json
  contributorCount Int      @map("contributor_count")
  frozenAt         DateTime @default(now()) @map("frozen_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([weekIndex], map: "idx_global_albums_snapshots_week_index")
  @@map("global_albums_snapshots")
}

enum EntityPageKind {
  ARTIST
  ALBUM
  SONG

  @@map("entity_page_kind")
}

/// Agregação diária das paradas (evita varrer todas as entradas em cada página).
model DailyChartSongStats {
  id             String   @id @default(cuid())
  snapshotDay    DateTime @unique @map("snapshot_day") @db.Date
  currentWeekIdx Int      @map("current_week_idx")
  weeklyBuckets  Json     @map("weekly_buckets")
  builtAt        DateTime @default(now()) @map("built_at")

  @@map("daily_chart_song_stats")
}

/// Cache diário do conteúdo público das páginas de artista, álbum e música.
model EntityPageSnapshot {
  id          String         @id @default(cuid())
  kind        EntityPageKind
  entityKey   String         @map("entity_key")
  payload     Json
  snapshotDay DateTime       @map("snapshot_day") @db.Date
  builtAt     DateTime       @default(now()) @map("built_at")

  @@unique([kind, entityKey, snapshotDay])
  @@index([kind, entityKey, snapshotDay(sort: Desc)], map: "idx_entity_page_snapshots_lookup")
  @@map("entity_page_snapshots")
}

model AlbumReview {
  id           String               @id @default(cuid())
  albumId      Int                  @map("album_id")
  userId       String               @map("user_id")
  rating       Int
  body         String?
  helpful      Int                  @default(0)
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  album        Album                @relation(fields: [albumId], references: [id], onDelete: Cascade)
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  helpfulVotes AlbumReviewHelpful[]

  @@unique([albumId, userId])
  @@index([albumId])
  @@map("album_reviews")
}

model AlbumReviewHelpful {
  id        String      @id @default(cuid())
  reviewId  String      @map("review_id")
  userId    String      @map("user_id")
  createdAt DateTime    @default(now()) @map("created_at")
  review    AlbumReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@map("album_review_helpful")
}

enum ClipType {
  OFFICIAL
  LYRIC_VIDEO
  VISUALIZER
  LIVE
  OTHER

  @@map("clip_type")
}

model SongVideoClip {
  id          String   @id @default(cuid())
  songId      String   @map("song_id")
  uploadedBy  String   @map("uploaded_by")
  youtubeId   String?  @map("youtube_id")
  imageUrl    String   @map("image_url")
  publishedAt DateTime? @map("published_at")
  clipType    ClipType  @default(OFFICIAL) @map("clip_type")
  votes       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  song        Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  uploader    User     @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)
  voteRecords SongVideoClipVote[]
  choices     UserSongVideoClipChoice[]

  @@index([songId], map: "idx_song_video_clips_song_id")
  @@index([uploadedBy], map: "idx_song_video_clips_uploaded_by")
  @@map("song_video_clips")
}

model SongVideoClipVote {
  id        String        @id @default(cuid())
  clipId    String        @map("clip_id")
  userId    String        @map("user_id")
  createdAt DateTime      @default(now()) @map("created_at")
  clip      SongVideoClip @relation(fields: [clipId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clipId, userId])
  @@map("song_video_clip_votes")
}

model UserSongVideoClipChoice {
  userId    String        @map("user_id")
  songId    String        @map("song_id")
  clipId    String        @map("clip_id")
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  song      Song          @relation(fields: [songId], references: [id], onDelete: Cascade)
  clip      SongVideoClip @relation(fields: [clipId], references: [id], onDelete: Cascade)

  @@id([userId, songId])
  @@map("user_song_video_clip_choices")
}

enum AlbumClubPhase {
  NOMINATIONS
  POLL
  RESULT
  LISTENING
  COMPLETED

  @@map("album_club_phase")
}

model AlbumClubRound {
  id                 String              @id @default(cuid())
  number             Int                 @unique
  theme              String
  dateRange          String              @map("date_range")
  phase              AlbumClubPhase      @default(NOMINATIONS)
  nominationsOpenAt  DateTime            @map("nominations_open_at")
  nominationsCloseAt DateTime            @map("nominations_close_at")
  pollCloseAt        DateTime            @map("poll_close_at")
  resultCloseAt      DateTime?           @map("result_close_at")
  listeningCloseAt   DateTime?           @map("listening_close_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  nominations        AlbumClubNomination[]
  pollVotes          AlbumClubPollVote[]
  winners            AlbumClubWinner[]

  @@map("album_club_rounds")
}

model AlbumClubNomination {
  id        String              @id @default(cuid())
  roundId   String              @map("round_id")
  userId    String              @map("user_id")
  albumId   Int                 @map("album_id")
  slot      Int
  createdAt DateTime            @default(now()) @map("created_at")
  round     AlbumClubRound      @relation(fields: [roundId], references: [id], onDelete: Cascade)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  album     Album               @relation(fields: [albumId], references: [id], onDelete: Cascade)
  pollVotes AlbumClubPollVote[]
  winner    AlbumClubWinner?

  @@unique([roundId, userId, slot])
  @@unique([roundId, userId, albumId])
  @@index([roundId], map: "idx_album_club_nominations_round_id")
  @@map("album_club_nominations")
}

model AlbumClubPollVote {
  id           String              @id @default(cuid())
  roundId      String              @map("round_id")
  userId       String              @map("user_id")
  nominationId String              @map("nomination_id")
  createdAt    DateTime            @default(now()) @map("created_at")
  round        AlbumClubRound      @relation(fields: [roundId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  nomination   AlbumClubNomination @relation(fields: [nominationId], references: [id], onDelete: Cascade)

  @@unique([roundId, userId, nominationId])
  @@index([roundId], map: "idx_album_club_poll_votes_round_id")
  @@index([nominationId], map: "idx_album_club_poll_votes_nomination_id")
  @@map("album_club_poll_votes")
}

model AlbumClubWinner {
  id           String              @id @default(cuid())
  roundId      String              @map("round_id")
  nominationId String              @unique @map("nomination_id")
  rank         Int
  voteCount    Int                 @map("vote_count")
  round        AlbumClubRound      @relation(fields: [roundId], references: [id], onDelete: Cascade)
  nomination   AlbumClubNomination @relation(fields: [nominationId], references: [id], onDelete: Cascade)

  @@unique([roundId, rank])
  @@map("album_club_winners")
}

model WeeklyRelease {
  id        String               @id @default(cuid())
  weekLabel String               @map("week_label")
  active    Boolean              @default(false)
  albums    WeeklyReleaseAlbum[]
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")

  @@map("weekly_releases")
}

/// Snapshots da parada pessoal MyTRL (seg–sex, gerados às 6h BRT).
model MyTrlSnapshot {
  id         String   @id @default(cuid())
  weekday    Int
  weekIndex  Int      @map("week_index")
  weekLabel  String   @map("week_label")
  dateRange  String   @map("date_range")
  entries    Json
  computedAt DateTime @default(now()) @map("computed_at")

  @@unique([weekday, weekIndex])
  @@index([weekday, weekIndex(sort: Desc)])
  @@map("mytrl_snapshots")
}

model WeeklyReleaseAlbum {
  id              String        @id @default(cuid())
  weeklyReleaseId String        @map("weekly_release_id")
  albumId         Int           @map("album_id")
  order           Int           @default(0)
  weeklyRelease   WeeklyRelease @relation(fields: [weeklyReleaseId], references: [id], onDelete: Cascade)
  album           Album         @relation(fields: [albumId], references: [id])

  @@unique([weeklyReleaseId, albumId])
  @@index([weeklyReleaseId], map: "idx_weekly_release_albums_release_id")
  @@map("weekly_release_albums")
}

// ─── Push Game ────────────────────────────────────────────────────────────────

enum PushPhase {
  SUBMISSION
  LISTENING
  RANKING
  RESULT

  @@map("push_phase")
}

model SongRecommendation {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  songId    String   @map("song_id")
  text      String?
  likes     Int      @default(0)
  comments  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  song      Song     @relation(fields: [songId], references: [id])
  recLikes  SongRecommendationLike[]
  recComments SongRecommendationComment[]

  @@index([createdAt(sort: Desc)])
  @@map("song_recommendations")
}

model SongRecommendationLike {
  id               String             @id @default(cuid())
  userId           String             @map("user_id")
  recommendationId String             @map("recommendation_id")
  createdAt        DateTime           @default(now()) @map("created_at")
  recommendation   SongRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  user             User               @relation(fields: [userId], references: [id])

  @@unique([userId, recommendationId])
  @@map("song_recommendation_likes")
}

model SongRecommendationComment {
  id               String             @id @default(cuid())
  recommendationId String             @map("recommendation_id")
  userId           String             @map("user_id")
  text             String
  likes            Int                @default(0)
  replyCount       Int                @default(0) @map("reply_count")
  createdAt        DateTime           @default(now()) @map("created_at")
  recommendation   SongRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  user             User               @relation(fields: [userId], references: [id])
  commentLikes     SongRecommendationCommentLike[]
  replies          SongRecommendationCommentReply[]

  @@index([recommendationId])
  @@map("song_recommendation_comments")
}

model SongRecommendationCommentLike {
  id        String                    @id @default(cuid())
  userId    String                    @map("user_id")
  commentId String                    @map("comment_id")
  createdAt DateTime                  @default(now()) @map("created_at")
  comment   SongRecommendationComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User                      @relation(fields: [userId], references: [id])

  @@unique([userId, commentId])
  @@map("song_recommendation_comment_likes")
}

model SongRecommendationCommentReply {
  id        String                    @id @default(cuid())
  commentId String                    @map("comment_id")
  userId    String                    @map("user_id")
  text      String
  likes     Int                       @default(0)
  createdAt DateTime                  @default(now()) @map("created_at")
  comment   SongRecommendationComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User                      @relation(fields: [userId], references: [id])

  @@index([commentId])
  @@map("song_recommendation_comment_replies")
}

model PushRound {
  id                String           @id @default(cuid())
  number            Int              @unique
  title             String?
  phase             PushPhase        @default(SUBMISSION)
  submissionEndsAt  DateTime         @map("submission_ends_at")
  listeningEndsAt   DateTime         @map("listening_ends_at")
  rankingEndsAt     DateTime         @map("ranking_ends_at")
  spotifyPlaylistId String?          @map("spotify_playlist_id")
  youtubePlaylistId String?          @map("youtube_playlist_id")
  season            Int              @default(1)
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  submissions       PushSubmission[]
  votes             PushVote[]

  @@map("push_rounds")
}

model PushSubmission {
  id             String      @id @default(cuid())
  roundId        String      @map("round_id")
  userId         String      @map("user_id")
  songId         String      @map("song_id")
  spotifyTrackId String      @unique @map("spotify_track_id")
  createdAt      DateTime    @default(now()) @map("created_at")
  round          PushRound   @relation(fields: [roundId], references: [id], onDelete: Cascade)
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  song           Song        @relation(fields: [songId], references: [id])
  votes          PushVote[]

  @@unique([roundId, userId])
  @@index([roundId])
  @@map("push_submissions")
}

model PushVote {
  id           String         @id @default(cuid())
  roundId      String         @map("round_id")
  userId       String         @map("user_id")
  submissionId String         @map("submission_id")
  position     Int
  submittedAt  DateTime       @default(now()) @map("submitted_at")
  round        PushRound      @relation(fields: [roundId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  submission   PushSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([roundId, userId, submissionId])
  @@index([roundId, userId])
  @@index([submissionId])
  @@map("push_votes")
}

// ── Copa ChartFM ──────────────────────────────────────────────────────────────

enum CopaStatus {
  REGISTRATION
  GROUP_STAGE
  KNOCKOUT
  FINISHED
}

enum CopaPhase {
  GROUP
  R16
  QF
  SF
  THIRD_PLACE
  FINAL
}

enum CopaFixtureStatus {
  UPCOMING
  LIVE
  DONE
}

model CopaEdition {
  id              String            @id @default(cuid())
  name            String
  year            Int
  status          CopaStatus        @default(REGISTRATION)
  maxParticipants Int               @default(8)  @map("max_participants")
  artistsPerUser  Int               @default(8)  @map("artists_per_user")
  startsAt        DateTime?         @map("starts_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  participants    CopaParticipant[]
  copaArtists     CopaArtist[]
  fixtures        CopaFixture[]
  dayPlaylists    CopaDayPlaylist[]

  @@map("copa_editions")
}

// Playlists (Spotify + YouTube) geradas automaticamente para cada "dia de jogos"
// (batchOrder 0..9). Uma linha por dia da Copa; idempotente via @@unique.
model CopaDayPlaylist {
  id                String      @id @default(cuid())
  copaId            String      @map("copa_id")
  batchOrder        Int         @map("batch_order")
  dayLabel          String      @map("day_label")
  spotifyPlaylistId String?     @map("spotify_playlist_id")
  youtubePlaylistId String?     @map("youtube_playlist_id")
  trackCount        Int         @default(0) @map("track_count")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  copa              CopaEdition @relation(fields: [copaId], references: [id], onDelete: Cascade)

  @@unique([copaId, batchOrder])
  @@map("copa_day_playlists")
}

model CopaParticipant {
  id        String      @id @default(cuid())
  copaId    String      @map("copa_id")
  userId    String      @map("user_id")
  copa      CopaEdition @relation(fields: [copaId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([copaId, userId])
  @@map("copa_participants")
}

model CopaArtist {
  id              String      @id @default(cuid())
  copaId          String      @map("copa_id")
  ownerId         String      @map("owner_id")
  groupLetter     String      @map("group_letter")
  slotInGroup     Int         @map("slot_in_group")
  artistSpotifyId String?     @map("artist_spotify_id")
  artistName      String      @map("artist_name")
  artistImage     String?     @map("artist_image")
  artistColor     String      @default("#FA243C") @map("artist_color")
  artistInitials  String      @default("??") @map("artist_initials")
  createdAt       DateTime    @default(now()) @map("created_at")
  copa            CopaEdition @relation(fields: [copaId], references: [id], onDelete: Cascade)
  owner           User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  singles         CopaSingle[]
  fixturesAsA     CopaFixture[] @relation("FixtureArtistA")
  fixturesAsB     CopaFixture[] @relation("FixtureArtistB")

  @@unique([copaId, artistSpotifyId])
  @@unique([copaId, groupLetter, slotInGroup])
  @@map("copa_artists")
}

model CopaSingle {
  id           String     @id @default(cuid())
  copaArtistId String     @map("copa_artist_id")
  slotIndex    Int        @map("slot_index")
  songId       String?    @map("song_id")
  songName     String     @map("song_name")
  copaArtist   CopaArtist @relation(fields: [copaArtistId], references: [id], onDelete: Cascade)

  @@unique([copaArtistId, slotIndex])
  @@map("copa_singles")
}

model CopaFixture {
  id          String            @id @default(cuid())
  copaId      String            @map("copa_id")
  phase       CopaPhase
  groupLetter String?           @map("group_letter")
  round       Int?
  matchIndex  Int               @map("match_index")
  artistAId   String            @map("artist_a_id")
  artistBId   String            @map("artist_b_id")
  singleAIdx  Int               @default(0) @map("single_a_idx")
  singleBIdx  Int               @default(0) @map("single_b_idx")
  status      CopaFixtureStatus @default(UPCOMING)
  createdAt   DateTime          @default(now()) @map("created_at")
  endedAt     DateTime?         @map("ended_at")
  copa        CopaEdition       @relation(fields: [copaId], references: [id], onDelete: Cascade)
  artistA     CopaArtist        @relation("FixtureArtistA", fields: [artistAId], references: [id])
  artistB     CopaArtist        @relation("FixtureArtistB", fields: [artistBId], references: [id])
  votes       CopaVote[]

  @@index([copaId, phase])
  @@index([copaId, groupLetter])
  @@map("copa_fixtures")
}

model CopaVote {
  id        String      @id @default(cuid())
  fixtureId String      @map("fixture_id")
  userId    String      @map("user_id")
  side      String      // "A" or "B"
  createdAt DateTime    @default(now()) @map("created_at")
  fixture   CopaFixture @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([fixtureId, userId])
  @@map("copa_votes")
}
