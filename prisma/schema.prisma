// ── Copa ChartFM ──────────────────────────────────────────────────────────────

enum CopaStatus {
  REGISTRATION
  GROUP_STAGE
  KNOCKOUT
  FINISHED
}

enum CopaPhase {
  GROUP
  R16
  QF
  SF
  THIRD_PLACE
  FINAL
  R32
}

enum CopaFixtureStatus {
  UPCOMING
  LIVE
  DONE
}

enum CopaEditionType {
  NORMAL
  PUSH
}

model CopaEdition {
  id                    String            @id @default(cuid())
  name                  String
  year                  Int
  status                CopaStatus        @default(REGISTRATION)
  type                  CopaEditionType   @default(NORMAL)
  maxParticipants       Int               @default(8) @map("max_participants")
  artistsPerUser        Int               @default(8) @map("artists_per_user")
  votesPerGoal          Int               @default(2) @map("votes_per_goal")
  startsAt              DateTime?         @map("starts_at")
  /// ID da playlist fixa "todas as músicas" da Copa Push (criada automaticamente na
  /// 1ª sincronização). Não usado por edições NORMAL, que usam a playlist fixa global.
  pushSpotifyPlaylistId String?           @map("push_spotify_playlist_id")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")
  participants          CopaParticipant[]
  copaArtists           CopaArtist[]
  fixtures              CopaFixture[]
  dayPlaylists          CopaDayPlaylist[]
  liveComments          CopaLiveComment[]

  @@map("copa_editions")
}

// Playlists (Spotify + YouTube) geradas automaticamente para cada "dia de jogos"
// (batchOrder 0..12). Uma linha por dia da Copa; idempotente via @@unique.
model CopaDayPlaylist {
  id                String      @id @default(cuid())
  copaId            String      @map("copa_id")
  batchOrder        Int         @map("batch_order")
  dayLabel          String      @map("day_label")
  spotifyPlaylistId String?     @map("spotify_playlist_id")
  youtubePlaylistId String?     @map("youtube_playlist_id")
  trackCount        Int         @default(0) @map("track_count")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  copa              CopaEdition @relation(fields: [copaId], references: [id], onDelete: Cascade)

  @@unique([copaId, batchOrder])
  @@map("copa_day_playlists")
}

model CopaParticipant {
  id     String      @id @default(cuid())
  copaId String      @map("copa_id")
  userId String      @map("user_id")
  copa   CopaEdition @relation(fields: [copaId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([copaId, userId])
  @@map("copa_participants")
}

model CopaArtist {
  id              String        @id @default(cuid())
  copaId          String        @map("copa_id")
  ownerId         String        @map("owner_id")
  groupLetter     String        @map("group_letter")
  slotInGroup     Int           @map("slot_in_group")
  artistSpotifyId String?       @map("artist_spotify_id")
  artistName      String        @map("artist_name")
  artistImage     String?       @map("artist_image")
  artistColor     String        @default("#FA243C") @map("artist_color")
  artistInitials  String        @default("??") @map("artist_initials")
  createdAt       DateTime      @default(now()) @map("created_at")
  copa            CopaEdition   @relation(fields: [copaId], references: [id], onDelete: Cascade)
  owner           User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  singles         CopaSingle[]
  fixturesAsA     CopaFixture[] @relation("FixtureArtistA")
  fixturesAsB     CopaFixture[] @relation("FixtureArtistB")

  @@unique([copaId, artistSpotifyId])
  @@unique([copaId, groupLetter, slotInGroup])
  @@map("copa_artists")
}

model CopaSingle {
  id           String     @id @default(cuid())
  copaArtistId String     @map("copa_artist_id")
  slotIndex    Int        @map("slot_index")
  songId       String?    @map("song_id")
  songName     String     @map("song_name")
  copaArtist   CopaArtist @relation(fields: [copaArtistId], references: [id], onDelete: Cascade)

  @@unique([copaArtistId, slotIndex])
  @@map("copa_singles")
}

model CopaFixture {
  id          String            @id @default(cuid())
  copaId      String            @map("copa_id")
  phase       CopaPhase
  groupLetter String?           @map("group_letter")
  round       Int?
  matchIndex  Int               @map("match_index")
  artistAId   String            @map("artist_a_id")
  artistBId   String            @map("artist_b_id")
  singleAIdx  Int               @default(0) @map("single_a_idx")
  singleBIdx  Int               @default(0) @map("single_b_idx")
  status      CopaFixtureStatus @default(UPCOMING)
  createdAt   DateTime          @default(now()) @map("created_at")
  endedAt     DateTime?         @map("ended_at")
  copa        CopaEdition       @relation(fields: [copaId], references: [id], onDelete: Cascade)
  artistA     CopaArtist        @relation("FixtureArtistA", fields: [artistAId], references: [id])
  artistB     CopaArtist        @relation("FixtureArtistB", fields: [artistBId], references: [id])
  votes       CopaVote[]

  @@index([copaId, phase])
  @@index([copaId, groupLetter])
  @@map("copa_fixtures")
}

model CopaVote {
  id        String      @id @default(cuid())
  fixtureId String      @map("fixture_id")
  userId    String      @map("user_id")
  side      String // "A" or "B"
  createdAt DateTime    @default(now()) @map("created_at")
  fixture   CopaFixture @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([fixtureId, userId])
  @@map("copa_votes")
}

/// Fila de votos automáticos (@bruno) para os jogos abertos da Copa — o cron
/// processa 1 item por minuto para os votos não caírem todos juntos.
model CopaAutoVoteQueue {
  id        String   @id @default(cuid())
  fixtureId String   @map("fixture_id")
  userId    String   @map("user_id")
  side      String // "A" or "B"
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("copa_auto_vote_queue")
}

model CopaLiveComment {
  id           String                @id @default(cuid())
  copaId       String                @map("copa_id")
  batchOrder   Int?                  @map("batch_order")
  userId       String                @map("user_id")
  text         String
  likes        Int                   @default(0)
  createdAt    DateTime              @default(now()) @map("created_at")
  copa         CopaEdition           @relation(fields: [copaId], references: [id], onDelete: Cascade)
  user         User                  @relation(fields: [userId], references: [id])
  commentLikes CopaLiveCommentLike[]

  @@index([copaId, batchOrder])
  @@map("copa_live_comments")
}

model CopaLiveCommentLike {
  id        String          @id @default(cuid())
  commentId String          @map("comment_id")
  userId    String          @map("user_id")
  createdAt DateTime        @default(now()) @map("created_at")
  comment   CopaLiveComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id])

  @@unique([commentId, userId])
  @@map("copa_live_comment_likes")
}

model WeeklyEditorial {
  id        Int      @id @default(autoincrement())
  weekIndex Int      @unique @map("week_index")
  body      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("weekly_editorials")
}

enum EditorialPostCategory {
  video
  clipe
  playlist
  album
  artista
  editorial
}

model EditorialPost {
  id           String                @id @default(cuid())
  slug         String                @unique
  title        String
  subtitle     String?
  category     EditorialPostCategory
  publishedAt  DateTime              @map("published_at") @db.Date
  author       String                @default("Equipe ChartFM")
  excerpt      String
  paragraphs   Json
  youtubeUrl   String?               @map("youtube_url")
  spotifyUrl   String?               @map("spotify_url")
  previewImage String?               @map("preview_image")
  tags         Json?
  relatedLinks Json?                 @map("related_links")
  published    Boolean               @default(true)
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  @@index([published, publishedAt(sort: Desc)])
  @@map("editorial_posts")
}

enum SupportTicketType {
  BUG
  SUGGESTION

  @@map("support_ticket_type")
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  CLOSED

  @@map("support_ticket_status")
}

model SupportTicket {
  id        String                 @id @default(cuid())
  userId    String                 @map("user_id")
  type      SupportTicketType
  subject   String
  status    SupportTicketStatus    @default(OPEN)
  createdAt DateTime               @default(now()) @map("created_at")
  updatedAt DateTime               @updatedAt @map("updated_at")
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  SupportTicketMessage[]

  @@index([userId])
  @@index([status, updatedAt])
  @@map("support_tickets")
}

model ApiRequestLog {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now()) @map("created_at")
  method       String
  path         String
  source       String // "user" | "system" | "anonymous"
  ok           Boolean  @default(true)
  statusCode   Int?     @map("status_code")
  errorMessage String?  @map("error_message") @db.Text
  userId       String?  @map("user_id")
  userName     String?  @map("user_name")
  userHandle   String?  @map("user_handle")

  @@index([createdAt])
  @@index([path, createdAt])
  @@map("api_request_logs")
}

model AnalyticsEvent {
  id        BigInt   @id @default(autoincrement())
  sessionId String   @map("session_id")
  userId    String?  @map("user_id")
  type      String // "pageview" | "heartbeat"
  path      String
  referrer  String?
  device    String? // "mobile" | "desktop"
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([sessionId, createdAt])
  @@index([userId, createdAt])
  @@map("analytics_events")
}

model AnalyticsDailyStat {
  id                Int      @id @default(autoincrement())
  date              DateTime @unique @db.Date
  visitors          Int      @default(0) // sessões únicas (inclui anônimos)
  loggedUsers       Int      @default(0) @map("logged_users") // usuários logados únicos (DAU)
  sessions          Int      @default(0)
  pageviews         Int      @default(0)
  totalSeconds      Int      @default(0) @map("total_seconds") // tempo total no site
  avgSessionSeconds Int      @default(0) @map("avg_session_seconds")
  signups           Int      @default(0)
  topPaths          Json?    @map("top_paths") // [{ path, views }]
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("analytics_daily_stats")
}

model EditorialPostDailyView {
  id    Int      @id @default(autoincrement())
  slug  String
  date  DateTime @db.Date
  views Int      @default(0)

  @@unique([slug, date])
  @@index([slug])
  @@index([date])
  @@map("editorial_post_daily_views")
}

model SupportTicketMessage {
  id        String        @id @default(cuid())
  ticketId  String        @map("ticket_id")
  userId    String        @map("user_id")
  body      String
  isStaff   Boolean       @default(false) @map("is_staff")
  createdAt DateTime      @default(now()) @map("created_at")
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("support_ticket_messages")
}

/// Enquete semanal (Melhor da Semana + Flashback da Semana). Abre domingo 23:59 BRT
/// com as indicações das paradas da semana; fecha na terça junto com o snapshot global.
model WeeklySpotlightPoll {
  id        String                  @id @default(cuid())
  weekIndex Int                     @unique @map("week_index")
  weekLabel String                  @map("week_label")
  dateRange String                  @map("date_range")
  status    String                  @default("open") // "open" | "closed"
  openedAt  DateTime                @default(now()) @map("opened_at")
  closedAt  DateTime?               @map("closed_at")
  options   WeeklySpotlightOption[]
  votes     WeeklySpotlightVote[]

  @@map("weekly_spotlight_polls")
}

model WeeklySpotlightOption {
  id          String                      @id @default(cuid())
  pollId      String                      @map("poll_id")
  category    String // "destaque" (Melhor da Semana) | "flashback"
  songId      String                      @map("song_id")
  voteCount   Int                         @default(0) @map("vote_count") // congelado na apuração: nº de ranqueadores que incluíram a opção
  totalPoints Int                         @default(0) @map("total_points") // congelado na apuração: soma dos pontos de posição (20→1, mesma curva do Push)
  isWinner    Boolean                     @default(false) @map("is_winner")
  createdAt   DateTime                    @default(now()) @map("created_at")
  poll        WeeklySpotlightPoll         @relation(fields: [pollId], references: [id], onDelete: Cascade)
  song        Song                        @relation(fields: [songId], references: [id], onDelete: Cascade)
  nominations WeeklySpotlightNomination[]
  votes       WeeklySpotlightVote[]

  @@unique([pollId, category, songId])
  @@index([pollId], map: "idx_weekly_spotlight_options_poll_id")
  @@map("weekly_spotlight_options")
}

/// Quem indicou a música na própria parada da semana (mostrado junto da vencedora).
model WeeklySpotlightNomination {
  id        String                @id @default(cuid())
  optionId  String                @map("option_id")
  userId    String                @map("user_id")
  createdAt DateTime              @default(now()) @map("created_at")
  option    WeeklySpotlightOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([optionId, userId])
  @@map("weekly_spotlight_nominations")
}

model WeeklySpotlightVote {
  id        String                @id @default(cuid())
  pollId    String                @map("poll_id")
  optionId  String                @map("option_id")
  userId    String                @map("user_id")
  position  Int // posição dada pelo usuário no ranking da categoria (1 = melhor), mesma curva de pontos do Push
  createdAt DateTime              @default(now()) @map("created_at")
  poll      WeeklySpotlightPoll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option    WeeklySpotlightOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([optionId, userId])
  @@index([pollId], map: "idx_weekly_spotlight_votes_poll_id")
  @@index([userId], map: "idx_weekly_spotlight_votes_user_id")
  @@map("weekly_spotlight_votes")
}

/// Radar de Lançamentos — artista monitorado no Spotify; o cron avisa novos lançamentos no Telegram.
/// `source`: "manual" (adicionado no admin, nunca removido automaticamente) ou
/// "global" (importado do top 200 do Global da semana; sai quando sai do top).
model ArtistReleaseWatch {
  id            Int                         @id @default(autoincrement())
  spotifyId     String                      @unique @map("spotify_id")
  name          String
  imageUrl      String?                     @map("image_url")
  source        String                      @default("manual")
  active        Boolean                     @default(true)
  createdAt     DateTime                    @default(now()) @map("created_at")
  lastCheckedAt DateTime?                   @map("last_checked_at")
  notifications ArtistReleaseNotification[]

  @@map("artist_release_watches")
}

/// Lançamento já registrado pelo radar (dedupe). `announced=false` = pré-existente ao monitoramento, não avisado.
model ArtistReleaseNotification {
  id             Int                @id @default(autoincrement())
  watchId        Int                @map("watch_id")
  albumSpotifyId String             @map("album_spotify_id")
  title          String
  albumType      String?            @map("album_type")
  releaseDate    String?            @map("release_date")
  announced      Boolean            @default(true)
  notifiedAt     DateTime           @default(now()) @map("notified_at")
  watch          ArtistReleaseWatch @relation(fields: [watchId], references: [id], onDelete: Cascade)

  @@unique([watchId, albumSpotifyId])
  @@index([notifiedAt], map: "idx_artist_release_notifications_notified_at")
  @@map("artist_release_notifications")
}

// ---------------------------------------------------------------------------
// Postagens Automáticas — fila editorial de publicação nas redes sociais
// (Facebook, Instagram Feed/Stories, Threads, Telegram). Ver
// sistema_postagens_automaticas_chartfm.md. Release Radar (acima) continua
// separado, exclusivo do Telegram.
// ---------------------------------------------------------------------------

enum SocialEventType {
  GLOBAL100_PUBLISHED
  AIRPLAY_PUBLISHED
  ALBUMS_CHART_PUBLISHED
  ALBUM_REVIEW_MILESTONE
  ALBUM_CLUB_WINNER
  PUSH_PHASE_CHANGE
  COPA_ROUND_START
  COPA_ROUND_RESULT
  COPA_FINAL_RESULT
  WEEKLY_POLL_OPEN
}

enum SocialPostPriority {
  CRITICAL
  HIGH
  NORMAL
  LOW
}

enum SocialPostStatus {
  PENDING
  SCHEDULED
  GENERATING
  READY
  PUBLISHING
  PUBLISHED
  PARTIALLY_PUBLISHED
  FAILED
  CANCELLED
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM_FEED
  INSTAGRAM_STORY
  THREADS
  TELEGRAM
}

enum SocialPublishStatus {
  PENDING
  PUBLISHED
  FAILED
  SKIPPED_CAP
}

/// Log bruto de eventos do site que podem virar conteúdo. Um SocialEvent gera no
/// máximo um SocialPost (checar elegibilidade antes de criar).
model SocialEvent {
  id         String          @id @default(cuid())
  eventType  SocialEventType @map("event_type")
  entityType String          @map("entity_type")
  entityId   String          @map("entity_id")
  payload    Json
  createdAt  DateTime        @default(now()) @map("created_at")
  posts      SocialPost[]

  @@index([eventType, entityId], map: "idx_social_events_type_entity")
  @@map("social_events")
}

/// Item da fila editorial. Pode gerar publicações em várias plataformas
/// (ver SocialPostPublication para o status por rede).
model SocialPost {
  id          String             @id @default(cuid())
  eventId     String?            @map("event_id")
  eventType   SocialEventType    @map("event_type")
  entityType  String             @map("entity_type")
  entityId    String             @map("entity_id")
  priority    SocialPostPriority @default(NORMAL)
  score       Int                @default(0)
  createdAt   DateTime           @default(now()) @map("created_at")
  scheduledAt DateTime?          @map("scheduled_at")
  expiresAt   DateTime?          @map("expires_at")
  status      SocialPostStatus   @default(PENDING)
  platforms   SocialPlatform[]

  captionInstagram String? @map("caption_instagram") @db.Text
  captionFacebook  String? @map("caption_facebook") @db.Text
  captionThreads   String? @map("caption_threads") @db.Text
  captionTelegram  String? @map("caption_telegram") @db.Text

  imageFeed45     String? @map("image_feed_45")
  imageTelegram11 String? @map("image_telegram_11")
  imageStory916   String? @map("image_story_916")

  hashtags String[]

  publishedAt       DateTime? @map("published_at")
  facebookPostId    String?   @map("facebook_post_id")
  instagramMediaId  String?   @map("instagram_media_id")
  threadsPostId     String?   @map("threads_post_id")
  telegramMessageId String?   @map("telegram_message_id")

  retryCount Int     @default(0) @map("retry_count")
  lastError  String? @map("last_error") @db.Text

  event        SocialEvent?            @relation(fields: [eventId], references: [id], onDelete: SetNull)
  publications SocialPostPublication[]

  @@index([status], map: "idx_social_posts_status")
  @@index([entityType, entityId], map: "idx_social_posts_entity")
  @@index([scheduledAt], map: "idx_social_posts_scheduled_at")
  @@map("social_posts")
}

/// Status de publicação por plataforma de um SocialPost (fonte de verdade para
/// PARTIALLY_PUBLISHED e para mostrar SKIPPED_CAP no admin).
model SocialPostPublication {
  id           String              @id @default(cuid())
  socialPostId String              @map("social_post_id")
  platform     SocialPlatform
  status       SocialPublishStatus @default(PENDING)
  externalId   String?             @map("external_id")
  error        String?             @db.Text
  publishedAt  DateTime?           @map("published_at")
  createdAt    DateTime            @default(now()) @map("created_at")

  post SocialPost @relation(fields: [socialPostId], references: [id], onDelete: Cascade)

  @@unique([socialPostId, platform])
  @@index([platform, publishedAt], map: "idx_social_post_publications_platform_published")
  @@map("social_post_publications")
}

/// Limite diário e liga/desliga por plataforma (configurável no admin).
model SocialPlatformConfig {
  platform SocialPlatform @id
  enabled  Boolean        @default(true)

  @@map("social_platform_configs")
}

/// Dia da semana + horário fixo em que cada tipo de evento é postado (ex.: as
/// paradas oficiais, terça 9h). 0=domingo…6=sábado, time em "HH:mm" (América/São_Paulo).
model SocialEventSchedule {
  eventType SocialEventType @id @map("event_type")
  weekday   Int
  time      String

  @@map("social_event_schedules")
}

/// Singleton (id fixo "default") com os horários dos slots e o fuso horário.
model SocialScheduleConfig {
  id       String   @id @default("default")
  slots    String[] @default(["07:00", "09:00", "13:00", "17:00", "19:00"])
  timezone String   @default("America/Sao_Paulo")

  @@map("social_schedule_configs")
}

/// Liga/desliga a automação de um tipo de evento sem mexer em código.
model SocialAutomationToggle {
  eventType SocialEventType @id @map("event_type")
  enabled   Boolean         @default(true)

  @@map("social_automation_toggles")
}

/// Métricas de desempenho por publicação/plataforma, coletadas quando a API permitir.
model SocialPostMetric {
  id           String         @id @default(cuid())
  socialPostId String         @map("social_post_id")
  platform     SocialPlatform
  likes        Int?
  comments     Int?
  shares       Int?
  reach        Int?
  impressions  Int?
  clicks       Int?
  fetchedAt    DateTime       @default(now()) @map("fetched_at")

  @@index([socialPostId, platform], map: "idx_social_post_metrics_post_platform")
  @@map("social_post_metrics")
}

/// Credenciais criptografadas das integrações sociais da plataforma (tokens de publicação).
enum SocialCredentialPlatform {
  FACEBOOK
  INSTAGRAM
  THREADS
  TELEGRAM
}

// ---------------------------------------------------------------------------
// TikTok Growth Bot — bot de Telegram (token próprio, separado do bot do
// ChartFM) que gerencia uma comunidade de crescimento mútuo no TikTok:
// cadastro de perfis via chat e divulgação automática em intervalos regulares.
// Ver Planejamento_TikTok_Growth_Bot.md. Admin em /admin/tiktok-bot (@bruno).
// ---------------------------------------------------------------------------

model TiktokBotUser {
  id                      Int               @id @default(autoincrement())
  telegramId              BigInt            @unique @map("telegram_id")
  telegramUsername        String?           @map("telegram_username")
  telegramName            String?           @map("telegram_name")
  tiktokUsername          String?           @unique @map("tiktok_username")
  /// Nicho de conteúdo (musica, humor, games, receitas, beleza, educacao, fotografia, outro).
  niche                   String?
  active                  Boolean           @default(true)
  banned                  Boolean           @default(false)
  /// true quando atingiu o limite de denúncias — sai da fila até revisão manual no admin.
  pendingReview           Boolean           @default(false) @map("pending_review")
  /// Estado da conversa: "register" | "edit" quando o bot aguarda o usuário do TikTok.
  pendingAction           String?           @map("pending_action")
  lastSharedAt            DateTime?         @map("last_shared_at")
  shareCount              Int               @default(0) @map("share_count")
  /// Confirmação periódica de participação (a cada 15 dias, via DM).
  lastConfirmedAt         DateTime?         @map("last_confirmed_at")
  confirmationRequestedAt DateTime?         @map("confirmation_requested_at")
  /// Verificação semanal do perfil no TikTok: quando checou e se retornou 404.
  accountCheckedAt        DateTime?         @map("account_checked_at")
  notFoundAt              DateTime?         @map("not_found_at")
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @updatedAt @map("updated_at")
  shares                  TiktokBotShare[]
  reports                 TiktokBotReport[]
  surveys                 TiktokBotSurvey[]

  @@index([active, lastSharedAt], map: "idx_tiktok_bot_users_active_last_shared")
  @@map("tiktok_bot_users")
}

/// Denúncia de perfil (conta fake, conteúdo adulto, spam) — 1 por denunciante/alvo.
model TiktokBotReport {
  id                 Int           @id @default(autoincrement())
  targetUserId       Int           @map("target_user_id")
  reporterTelegramId BigInt        @map("reporter_telegram_id")
  createdAt          DateTime      @default(now()) @map("created_at")
  target             TiktokBotUser @relation(fields: [targetUserId], references: [id], onDelete: Cascade)

  @@unique([targetUserId, reporterTelegramId])
  @@map("tiktok_bot_reports")
}

/// Pesquisa de retorno pós-divulgação: "quantos seguidores você ganhou?" via DM.
model TiktokBotSurvey {
  id         Int           @id @default(autoincrement())
  userId     Int           @map("user_id")
  askedAt    DateTime      @default(now()) @map("asked_at")
  answeredAt DateTime?     @map("answered_at")
  /// Faixa respondida: "0-5" | "6-20" | "21-50" | "50+".
  bucket     String?
  user       TiktokBotUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, askedAt], map: "idx_tiktok_bot_surveys_user_asked")
  @@map("tiktok_bot_surveys")
}

model TiktokBotGroup {
  id              Int              @id @default(autoincrement())
  telegramGroupId BigInt           @unique @map("telegram_group_id")
  title           String?
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now()) @map("created_at")
  shares          TiktokBotShare[]

  @@map("tiktok_bot_groups")
}

model TiktokBotShare {
  id        Int            @id @default(autoincrement())
  userId    Int            @map("user_id")
  groupId   Int            @map("group_id")
  sharedAt  DateTime       @default(now()) @map("shared_at")
  messageId BigInt?        @map("message_id")
  user      TiktokBotUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group     TiktokBotGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([sharedAt], map: "idx_tiktok_bot_shares_shared_at")
  @@map("tiktok_bot_shares")
}

/// Singleton (id fixo "default") com a configuração do bot.
model TiktokBotSettings {
  id                   String    @id @default("default")
  enabled              Boolean   @default(true)
  /// Intervalo mínimo entre divulgações automáticas (o cron roda a cada 30 min e respeita isto).
  shareIntervalMinutes Int       @default(30) @map("share_interval_minutes")
  profilesPerPost      Int       @default(5) @map("profiles_per_post")
  welcomeMessage       String    @default("👋 Bem-vindo ao TikTok Growth!\n\nPara participar das divulgações automáticas, cadastre seu usuário do TikTok.") @map("welcome_message")
  /// Telegram IDs (numéricos) com acesso aos comandos de admin do bot.
  adminTelegramIds     String[]  @default([]) @map("admin_telegram_ids")
  lastShareAt          DateTime? @map("last_share_at")
  /// Divulgar só um nicho (null = misturar todos).
  nicheFilter          String?   @map("niche_filter")
  /// Follow Friday: mensagem especial de sexta 19h com um lote grande de perfis.
  followFridayEnabled  Boolean   @default(true) @map("follow_friday_enabled")
  followFridayCount    Int       @default(25) @map("follow_friday_count")
  lastFollowFridayAt   DateTime? @map("last_follow_friday_at")
  /// Pesquisa de retorno pós-divulgação (DM) e confirmação periódica de participação.
  surveyEnabled        Boolean   @default(true) @map("survey_enabled")
  confirmationEnabled  Boolean   @default(true) @map("confirmation_enabled")

  @@map("tiktok_bot_settings")
}

model SocialCredential {
  id              Int                      @id @default(autoincrement())
  platform        SocialCredentialPlatform @unique
  accessToken     String                   @map("access_token")
  accountId       String?                  @map("account_id")
  accountUsername String?                  @map("account_username")
  expiresAt       DateTime?                @map("expires_at")
  lastRefreshedAt DateTime?                @map("last_refreshed_at")
  lastCheckedAt   DateTime?                @map("last_checked_at")
  refreshEnabled  Boolean                  @default(false) @map("refresh_enabled")
  refreshFailures Int                      @default(0) @map("refresh_failures")
  lastError       String?                  @map("last_error")
  lastErrorAt     DateTime?                @map("last_error_at")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  @@map("social_credentials")
}
