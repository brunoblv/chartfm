generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  ADMIN
  DEV
}

model User {
  id                               String                           @id @default(cuid())
  handle                           String                           @unique
  name                             String
  email                            String?                          @unique
  image                            String?
  googleId                         String?                          @unique
  passwordHash                     String?                          @map("password_hash")
  emailVerifiedAt                  DateTime?                        @map("email_verified_at")
  avatarColor                      String                           @default("#FA243C")
  bio                              String?
  followers                        Int                              @default(0)
  following                        Int                              @default(0)
  streak                           Int                              @default(0)
  verified                         Boolean                          @default(false)
  createdAt                        DateTime                         @default(now())
  updatedAt                        DateTime                         @updatedAt
  paradaNome                       String?
  genres                           String[]                         @default([])
  role                             UserRole                         @default(USER)
  needsHandle                      Boolean                          @default(false) @map("needs_handle")
  lastfmUser                       String?
  spotifyAccessToken               String?                          @map("spotify_access_token")
  spotifyRefreshToken              String?                          @map("spotify_refresh_token")
  spotifyTokenExpiresAt            DateTime?                        @map("spotify_token_expires_at")
  spotifyUserId                    String?                          @map("spotify_user_id")
  spotifyNewHitsPlaylistId         String?                          @map("spotify_new_hits_playlist_id")
  youtubeAccessToken               String?                          @map("youtube_access_token")
  youtubeRefreshToken              String?                          @map("youtube_refresh_token")
  youtubeTokenExpiresAt            DateTime?                        @map("youtube_token_expires_at")
  youtubeChannelId                 String?                          @map("youtube_channel_id")
  youtubeChannelHandle             String?                          @map("youtube_channel_handle")
  twitterUser                      String?
  instagramUser                    String?
  chartSize                        Int?                             @map("chart_size")
  paradaLogo                       String?                          @map("parada_logo")
  paradas                          Parada[]
  charts                           Chart[]
  likes                            ChartLike[]
  reposts                          ChartRepost[]
  comments                         Comment[]
  commentLikes                     CommentLike[]
  commentReplies                   CommentReply[]
  paradaComments                   ParadaComment[]
  paradaCommentLikes               ParadaCommentLike[]
  communityMemberships             CommunityMember[]
  actorNotifs                      Notification[]                   @relation("NotificationActor")
  notifications                    Notification[]                   @relation("NotificationRecipient")
  posts                            Post[]
  postLikes                        PostLike[]
  postReplies                      PostReply[]
  postReplyLikes                   PostReplyLike[]
  albumReviews                     AlbumReview[]
  albumReviewHelpful               AlbumReviewHelpful[]
  ownedCommunities                 Community[]                      @relation("CommunityOwner")
  followerLinks                    UserFollow[]                     @relation("UserFollows")
  followingLinks                   UserFollow[]                     @relation("UserFollowing")
  uploadedVideoClips               SongVideoClip[]
  videoClipVotes                   SongVideoClipVote[]
  videoClipChoices                 UserSongVideoClipChoice[]
  albumClubNominations             AlbumClubNomination[]
  albumClubPollVotes               AlbumClubPollVote[]
  pushSubmissions                  PushSubmission[]
  pushVotes                        PushVote[]
  songRecommendations              SongRecommendation[]
  songRecommendationLikes          SongRecommendationLike[]
  songRecommendationComments       SongRecommendationComment[]
  songRecommendationCommentLikes   SongRecommendationCommentLike[]
  songRecommendationCommentReplies SongRecommendationCommentReply[]
  copaParticipations               CopaParticipant[]
  copaArtists                      CopaArtist[]
  copaVotes                        CopaVote[]
  copaLiveComments                 CopaLiveComment[]
  copaLiveCommentLikes             CopaLiveCommentLike[]
  passwordResetTokens              PasswordResetToken[]
  emailVerificationTokens          EmailVerificationToken[]
  supportTickets                   SupportTicket[]
  supportTicketMessages            SupportTicketMessage[]
  weeklySpotlightNominations       WeeklySpotlightNomination[]
  weeklySpotlightVotes             WeeklySpotlightVote[]
  songFlags                        SongFlag[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model Artist {
  id                        Int        @id @default(autoincrement())
  spotifyId                 String     @unique @map("spotify_id")
  name                      String
  exhibitionName            String?    @map("exhibition_name")
  genres                    String[]   @default([])
  imageUrl                  String?    @map("image_url")
  spotifyUrl                String?    @map("spotify_url")
  bio                       String?
  /// Backfill automático (Wikipedia) não achou bio — não tentar de novo até correção manual.
  bioNotFoundAt             DateTime?  @map("bio_not_found_at")
  /// Backfill automático (Spotify/MusicBrainz) não achou imagem/link/gêneros — não tentar de novo até correção manual.
  metadataNotFoundAt        DateTime?  @map("metadata_not_found_at")
  /// Fontes (spotify/lastfm/musicbrainz/wikipedia) já consultadas para este artista sem retorno — não tentar de novo até forçar.
  sourcesNotFound           String[]   @default([]) @map("sources_not_found")
  /// Ouvintes mensais no Spotify (scraping de open.spotify.com) — usado pelo limite de audiência da Copa Push.
  monthlyListeners          Int?       @map("monthly_listeners")
  monthlyListenersFetchedAt DateTime?  @map("monthly_listeners_fetched_at")
  createdAt                 DateTime   @default(now()) @map("created_at")
  updatedAt                 DateTime   @updatedAt @map("updated_at")
  albums                    Album[]
  songs                     Song[]     @relation("PrimarySongArtist")
  feats                     SongFeat[]

  @@index([spotifyId], map: "idx_artists_spotify_id")
  @@map("artists")
}

enum AlbumType {
  SINGLE
  EP
  ALBUM
  COMPILATION

  @@map("album_type")
}

model Album {
  id                  Int                   @id @default(autoincrement())
  spotifyId           String                @unique @map("spotify_id")
  title               String
  exhibitionName      String?               @map("exhibition_name")
  artistSpotifyId     String                @map("artist_spotify_id")
  albumType           AlbumType?            @map("album_type")
  releaseDate         DateTime?             @map("release_date") @db.Date
  coverUrl            String?               @map("cover_url")
  spotifyUrl          String?               @map("spotify_url")
  totalTracks         Int?                  @map("total_tracks")
  label               String?               @map("label")
  /// Backfill automático (Spotify) não achou capa/data/tipo/faixas — não tentar de novo até correção manual.
  metadataNotFoundAt  DateTime?             @map("metadata_not_found_at")
  /// Fontes (spotify/lastfm/musicbrainz/wikipedia) já consultadas para este álbum sem retorno — não tentar de novo até forçar.
  sourcesNotFound     String[]              @default([]) @map("sources_not_found")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")
  artist              Artist                @relation(fields: [artistSpotifyId], references: [spotifyId])
  songs               Song[]                @relation("AlbumSongs")
  chartEntries        ChartEntry[]          @relation("ChartEntryAlbumSpotify")
  reviews             AlbumReview[]
  clubNominations     AlbumClubNomination[]
  weeklyReleaseAlbums WeeklyReleaseAlbum[]

  @@index([spotifyId], map: "idx_albums_spotify_id")
  @@index([artistSpotifyId], map: "idx_albums_artist_spotify_id")
  @@map("albums")
}

model Song {
  id                         String                    @id @default(cuid())
  title                      String
  exhibitionName             String?                   @map("exhibition_name")
  artist                     String
  album                      String?
  entries                    ChartEntry[]
  chartsAsFlashback          Chart[]                   @relation("ChartFlashback")
  chartsAsDestaque           Chart[]                   @relation("ChartDestaque")
  spotifyId                  String?                   @unique @map("spotify_id")
  artistSpotifyId            String?                   @map("artist_spotify_id")
  albumSpotifyId             String?                   @map("album_spotify_id")
  durationMs                 Int?                      @map("duration_ms")
  previewUrl                 String?                   @map("preview_url")
  spotifyUrl                 String?                   @map("spotify_url")
  trackNumber                Int?                      @map("track_number")
  genres                     String[]                  @default([])
  genreSource                String?                   @map("genre_source")
  recordingMbid              String?                   @map("recording_mbid")
  isrc                       String?                   @map("isrc")
  genresFetchedAt            DateTime?                 @map("genres_fetched_at")
  singleReleaseDate          DateTime?                 @map("single_release_date") @db.Date
  musicVideoReleaseDate      DateTime?                 @map("music_video_release_date") @db.Date
  youtubeReleaseDate         DateTime?                 @map("youtube_release_date") @db.Date
  singleReleaseDateFetchedAt DateTime?                 @map("single_release_date_fetched_at")
  /// Backfill automático (Wikipedia/MB) não achou datas — não tentar de novo até correção manual.
  releaseDatesNotFoundAt     DateTime?                 @map("release_dates_not_found_at")
  releaseDatesVersion        Int                       @default(0) @map("release_dates_version")
  /// Fontes (spotify/lastfm/musicbrainz/wikipedia) já consultadas para esta música sem retorno — não tentar de novo até forçar.
  sourcesNotFound            String[]                  @default([]) @map("sources_not_found")
  /// Cadastrada à mão na tela de criar parada (Spotify indisponível) — artista/álbum podem ser texto livre, sem vínculo Spotify ainda.
  createdManually            Boolean                   @default(false) @map("created_manually")
  editorialNote              String?                   @map("editorial_note")
  createdAt                  DateTime                  @default(now()) @map("created_at")
  artistRef                  Artist?                   @relation("PrimarySongArtist", fields: [artistSpotifyId], references: [spotifyId])
  albumRef                   Album?                    @relation("AlbumSongs", fields: [albumSpotifyId], references: [spotifyId])
  feats                      SongFeat[]
  chartEntriesBySpotify      ChartEntry[]              @relation("ChartEntrySongSpotify")
  videoClips                 SongVideoClip[]
  videoClipChoices           UserSongVideoClipChoice[]
  pushSubmissions            PushSubmission[]
  recommendations            SongRecommendation[]
  weeklySpotlightOptions     WeeklySpotlightOption[]
  flags                      SongFlag[]

  @@unique([title, artist])
  @@index([spotifyId], map: "idx_songs_spotify_id")
  @@index([artistSpotifyId], map: "idx_songs_artist_spotify_id")
  @@index([albumSpotifyId], map: "idx_songs_album_spotify_id")
}

enum SongFlagStatus {
  PENDING
  DISMISSED

  @@map("song_flag_status")
}

/// Denúncia de usuário: "essa música não está correta" (duplicata, versão errada, etc).
/// Resolvida via merge no admin (a música some junto com a flag) ou dispensada (status DISMISSED).
model SongFlag {
  id        String         @id @default(cuid())
  songId    String         @map("song_id")
  userId    String         @map("user_id")
  reason    String?
  status    SongFlagStatus @default(PENDING)
  createdAt DateTime       @default(now()) @map("created_at")
  song      Song           @relation(fields: [songId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([songId])
  @@index([status])
  @@map("song_flags")
}

model SongFeat {
  id              Int      @id @default(autoincrement())
  songSpotifyId   String   @map("song_spotify_id")
  artistSpotifyId String   @map("artist_spotify_id")
  createdAt       DateTime @default(now()) @map("created_at")
  song            Song     @relation(fields: [songSpotifyId], references: [spotifyId], onDelete: Cascade)
  artist          Artist   @relation(fields: [artistSpotifyId], references: [spotifyId])

  @@unique([songSpotifyId, artistSpotifyId])
  @@index([songSpotifyId], map: "idx_song_feats_song_spotify_id")
  @@index([artistSpotifyId], map: "idx_song_feats_artist_spotify_id")
  @@map("song_feats")
}

enum ChartType {
  SONGS
  ALBUMS
  MIXED
  VIDEO_CLIP
}

enum ParadaCadence {
  WEEKLY
  DAILY
}

model Parada {
  id                  String        @id @default(cuid())
  userId              String        @map("user_id")
  name                String
  logo                String?       @map("logo")
  // Descrição livre, opcional, definida pelo usuário — exibida acima do texto autogerado no detalhe do chart.
  description         String?       @map("description")
  genres              String[]      @default([])
  isPrimary           Boolean       @default(true) @map("is_primary")
  sortOrder           Int           @default(0) @map("sort_order")
  chartSize           Int?          @map("chart_size")
  cadence             ParadaCadence @default(WEEKLY)
  // Parada oficial de uma comunidade (charts com Chart.communityId) — vive sob um userId
  // por exigência do schema, mas não é "do usuário": some do perfil dele e não conta no limite.
  isCommunityOfficial Boolean       @default(false) @map("is_community_official")
  // Paradas "de estilo" simuladas: toda semana as músicas caem aleatoriamente 1-7
  // posições até sair, e a(s) vaga(s) no topo são preenchidas com novas faixas do
  // Last.fm dos usuários-fonte, filtradas por `genres`. Ver lib/genre-parada-decay.ts.
  autoDecay           Boolean       @default(false) @map("auto_decay")
  sourceLastfmUsers   String[]      @default([]) @map("source_lastfm_users")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  deletedAt           DateTime?     @map("deleted_at")
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  charts              Chart[]

  @@unique([userId, sortOrder])
  @@index([userId], map: "idx_paradas_user_id")
  @@index([deletedAt], map: "idx_paradas_deleted_at")
  @@map("paradas")
}

model Chart {
  id              String        @id @default(cuid())
  userId          String
  paradaId        String        @map("parada_id")
  weekIndex       Int
  weekLabel       String
  dateRange       String
  publishedAt     DateTime      @default(now())
  postedAt        DateTime      @default(now())
  likes           Int           @default(0)
  comments        Int           @default(0)
  reposts         Int           @default(0)
  user            User          @relation(fields: [userId], references: [id])
  parada          Parada        @relation(fields: [paradaId], references: [id], onDelete: Cascade)
  entries         ChartEntry[]
  chartLikes      ChartLike[]
  chartReposts    ChartRepost[]
  chartComments   Comment[]
  slug            String?       @unique
  title           String?
  description     String?
  chartType       ChartType     @default(SONGS) @map("chart_type")
  weekStartDate   DateTime?     @map("week_start_date") @db.Date
  isPublished     Boolean       @default(true) @map("is_published")
  maxItems        Int           @default(100) @map("max_items")
  communityId     String?       @map("community_id")
  community       Community?    @relation(fields: [communityId], references: [id])
  flashbackSongId String?       @map("flashback_song_id")
  destaqueSongId  String?       @map("destaque_song_id")
  flashbackSong   Song?         @relation("ChartFlashback", fields: [flashbackSongId], references: [id], onDelete: SetNull)
  destaqueSong    Song?         @relation("ChartDestaque", fields: [destaqueSongId], references: [id], onDelete: SetNull)

  @@unique([paradaId, weekIndex])
  @@index([userId, weekStartDate], map: "idx_charts_user_week")
  @@index([paradaId], map: "idx_charts_parada_id")
  @@index([communityId], map: "charts_communityId_fkey")
  @@index([slug], map: "idx_charts_slug")
  @@index([postedAt])
}

model ChartEntry {
  id             String   @id @default(cuid())
  chartId        String
  songId         String
  position       Int
  points         Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at")
  songSpotifyId  String?  @map("song_spotify_id")
  albumSpotifyId String?  @map("album_spotify_id")
  status         String   @default("new")
  delta          Int?
  prevPos        Int?
  peak           Int
  weeks          Int      @default(1)
  coverPaletteA  String   @default("#FF6B6B")
  coverPaletteB  String   @default("#FFE66D")
  coverSeed      Int      @default(0)
  chart          Chart    @relation(fields: [chartId], references: [id], onDelete: Cascade)
  song           Song     @relation(fields: [songId], references: [id])
  songBySpotify  Song?    @relation("ChartEntrySongSpotify", fields: [songSpotifyId], references: [spotifyId])
  albumBySpotify Album?   @relation("ChartEntryAlbumSpotify", fields: [albumSpotifyId], references: [spotifyId])

  @@unique([chartId, position])
  @@index([chartId, position], map: "idx_chart_entries_chart_position")
  @@index([songId], map: "idx_chart_entries_song_id")
  @@index([songId, position], map: "idx_chart_entries_song_position")
  @@index([songSpotifyId], map: "idx_chart_entries_song_spotify_id")
  @@index([albumSpotifyId], map: "idx_chart_entries_album_spotify_id")
}

model ChartLike {
  id        String   @id @default(cuid())
  userId    String
  chartId   String
  createdAt DateTime @default(now())
  chart     Chart    @relation(fields: [chartId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, chartId])
}

model ChartRepost {
  id        String   @id @default(cuid())
  userId    String
  chartId   String
  createdAt DateTime @default(now())
  chart     Chart    @relation(fields: [chartId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, chartId])
}

model Comment {
  id           String         @id @default(cuid())
  chartId      String
  userId       String
  text         String
  likes        Int            @default(0)
  reactions    String         @default("[]")
  replyCount   Int            @default(0)
  createdAt    DateTime       @default(now())
  chart        Chart          @relation(fields: [chartId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id])
  commentLikes CommentLike[]
  replies      CommentReply[]
}

model CommentLike {
  id        String   @id @default(cuid())
  userId    String
  commentId String   @map("comment_id")
  createdAt DateTime @default(now())
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, commentId])
  @@map("comment_likes")
}

model CommentReply {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  text      String
  likes     Int      @default(0)
  createdAt DateTime @default(now())
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@index([commentId])
}

model ParadaComment {
  id           String              @id @default(cuid())
  communityId  String?
  genreSlug    String?
  section      String
  period       String
  weekIndex    Int?
  userId       String
  text         String
  likes        Int                 @default(0)
  createdAt    DateTime            @default(now())
  community    Community?          @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id])
  commentLikes ParadaCommentLike[]

  @@index([communityId, genreSlug, section, period, weekIndex])
}

model ParadaCommentLike {
  id              String        @id @default(cuid())
  paradaCommentId String
  userId          String
  createdAt       DateTime      @default(now())
  paradaComment   ParadaComment @relation(fields: [paradaCommentId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id])

  @@unique([paradaCommentId, userId])
}

model Community {
  id                  String            @id @default(cuid())
  slug                String            @unique
  name                String
  tagline             String
  icon                String            @default("🎵")
  logoUrl             String?
  coverA              String            @default("#FA243C")
  coverB              String            @default("#FF5858")
  coverImageUrl       String?
  members             Int               @default(0)
  posts               Int               @default(0)
  founded             String
  privacy             String            @default("public")
  rules               String?
  createdAt           DateTime          @default(now())
  communityMembers    CommunityMember[]
  communityPosts      Post[]
  maxSongs            Int               @default(50)
  paradaName          String            @default("Parada")
  memberPositionLimit Int?
  pointsMode          String            @default("member")
  customPoints        Json?
  isPublic            Boolean           @default(true)
  ownerId             String?
  owner               User?             @relation("CommunityOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  charts              Chart[]
  paradaComments      ParadaComment[]

  @@index([ownerId], map: "communities_ownerId_fkey")
}

model CommunityMember {
  id          String    @id @default(cuid())
  userId      String
  communityId String
  role        String    @default("member")
  joinedAt    DateTime  @default(now())
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id])

  @@unique([userId, communityId])
}

model Post {
  id            String      @id @default(cuid())
  communityId   String
  userId        String
  kind          String      @default("text")
  text          String
  imageUrl      String?
  imagePaletteA String?
  imagePaletteB String?
  imageText     String?
  imageCaption  String?
  youtubeId     String?
  ytTitle       String?
  ytChannel     String?
  ytThumbA      String?
  ytThumbB      String?
  likes         Int         @default(0)
  replies       Int         @default(0)
  shares        Int         @default(0)
  createdAt     DateTime    @default(now())
  community     Community   @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id])
  postLikes     PostLike[]
  postReplies   PostReply[]
}

model PostLike {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, postId])
}

model PostReply {
  id           String          @id @default(cuid())
  postId       String
  userId       String
  text         String
  likes        Int             @default(0)
  replyToId    String?
  createdAt    DateTime        @default(now())
  post         Post            @relation(fields: [postId], references: [id], onDelete: Cascade)
  user         User            @relation(fields: [userId], references: [id])
  replyTo      PostReply?      @relation("PostReplyToReply", fields: [replyToId], references: [id], onDelete: SetNull)
  childReplies PostReply[]     @relation("PostReplyToReply")
  replyLikes   PostReplyLike[]

  @@index([postId])
  @@index([replyToId])
}

model PostReplyLike {
  id        String    @id @default(cuid())
  userId    String
  replyId   String
  createdAt DateTime  @default(now())
  reply     PostReply @relation(fields: [replyId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@unique([userId, replyId])
}

model Notification {
  id          String   @id @default(cuid())
  recipientId String
  actorId     String?
  type        String
  text        String
  targetUrl   String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  actor       User?    @relation("NotificationActor", fields: [actorId], references: [id])
  recipient   User     @relation("NotificationRecipient", fields: [recipientId], references: [id])
}

/// Post automático "da casa" (ChartFM) exibido no feed da home, ex.: Copa/Push publicados ou rodada avançou.
model SystemFeedPost {
  id        String   @id @default(cuid())
  kind      String
  text      String
  targetUrl String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Aviso programado ou recorrente criado pelo admin — notifica todos + post no feed da ChartFM.
model ScheduledAnnouncement {
  id            String    @id @default(cuid())
  label         String?
  text          String
  targetUrl     String?
  notifyType    String    @default("admin_announcement")
  feedKind      String    @default("admin_announcement")
  templateId    String?   @map("template_id")
  contextKey    String?   @map("context_key")
  status        String    @default("active")
  scheduleMode  String    @map("schedule_mode")
